# Copy to .env and fill in. Never commit .env.

# --- Database ---------------------------------------------------------------
# Any Postgres 16+ instance. Local docker, Neon, RDS — Prisma doesn't care.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/globalmentor360?schema=public"

# --- Auth (Better Auth) -----------------------------------------------------
# Generate with: npx @better-auth/cli secret
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
# Used by the auth client for absolute URLs in the browser.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Video (AWS) ------------------------------------------------------------
# Reuses the existing GlobalMentor360 AWS account resources (ap-south-1).
# Rotate the access keys / CloudFront key pair before filling these in — the
# previous prototype committed them to git history.
AWS_REGION="ap-south-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET="globalmentor360-mumbai"
AWS_MEDIACONVERT_ENDPOINT="https://mediaconvert.ap-south-1.amazonaws.com"
AWS_MEDIACONVERT_ROLE_ARN="arn:aws:iam::304708116601:role/GlobalMentor360-MediaConvert-Role"
AWS_CLOUDFRONT_DOMAIN="d27v0f4tiwjim8.cloudfront.net"
# CloudFront public key id (starts with K), from a v2 key group attached as a
# trusted key group on the distribution. Not the leaked IAM CloudFront key pair
# (APKA…). Leave empty until rotated into your local .env.
AWS_CLOUDFRONT_KEY_PAIR_ID=""
# PEM private key matching that public key. Prefer a single-line value with
# \n escapes, or a multiline quoted string. Never commit the real key.
AWS_CLOUDFRONT_PRIVATE_KEY=""
# Shared secret the EventBridge API destination should send as x-webhook-secret
# to POST /api/video/webhook. The HTTP webhook waits for a public domain —
# AWS cannot reach localhost, and there is no leftover public HTTPS origin for
# v2 (old Amplify is a different app). Until you have a public origin,
# MediaConvert COMPLETE/ERROR events are parked on SQS (Always Free) by rule
# GlobalMentor360v2-MediaConvert-JobState. Local-dev status: studio "Check
# status" (and opening the curriculum list) drains this queue.
# Do not create an EventBridge Connection yet — it stores this secret in
# Secrets Manager (~$0.40/month even if the destination is disabled). When
# you have HTTPS: Connection auth API_KEY header x-webhook-secret, API
# destination POST {origin}/api/video/webhook, add it as a target on that rule.
AWS_VIDEO_WEBHOOK_SECRET=""
# SQS queue EventBridge writes MediaConvert COMPLETE/ERROR to. The app short-
# polls it on studio refresh / curriculum listing (up to 30 messages, no
# long-poll). Leave empty to skip the drain; S3 HeadObject refresh still works
# for READY, but FAILED only arrives via this queue or the HTTP webhook.
AWS_VIDEO_EVENT_QUEUE_URL="https://sqs.ap-south-1.amazonaws.com/304708116601/GlobalMentor360v2-MediaConvert-Events"

# --- Email (AWS SES) --------------------------------------------------------
# Verification and password-reset emails. Uses the AWS credentials above.
# This account is in the SES sandbox (production sending access was denied):
# only verified identities/recipients can receive mail. Leave empty in local
# dev — emails print to the server console, links included. Production refuses
# that fallback, so real sign-ups need working mail. EMAIL_FROM must match a
# verified SES identity in ap-south-1. Custom-domain DKIM is not available on
# Gmail.
EMAIL_FROM=""

# --- Payments (bKash manual) --------------------------------------------------
# The academy's bKash number learners send money to (personal or merchant).
# Shown on checkout/cart transfer instructions when set. Leave empty until you
# have one — checkout then tells learners the number will be shared by the
# academy instead of referencing a number that is never displayed.
BKASH_MERCHANT_NUMBER=""

# --- Payments (Stripe) ------------------------------------------------------
# One-time payments only — no subscriptions. Leave empty to hide the card rail.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Local webhook forwarding: stripe listen --forward-to localhost:3000/api/webhooks/stripe

# --- Tests (optional) -------------------------------------------------------
# Origin for `npm run verify:apis`. Falls back to PLAYWRIGHT_BASE_URL, then
# http://localhost:3000. Leave empty for the local default.
VERIFY_API_BASE_URL=""
# Origin for Playwright e2e (`npm run test:e2e`) and as fallback for API
# verify. Leave empty to use http://localhost:3000.
PLAYWRIGHT_BASE_URL=""
