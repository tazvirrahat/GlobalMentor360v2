# Copy to .env and fill in. Never commit .env.

# --- Database ---------------------------------------------------------------
# Any Postgres 16+ instance. Local docker, Neon, RDS — Prisma doesn't care.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/globalmentor360?schema=public"

# --- Auth (Better Auth) -----------------------------------------------------
# Generate with: npx @better-auth/cli secret
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
# Used by the auth client for absolute URLs in the browser.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Video (AWS) ------------------------------------------------------------
# Reuses the existing GlobalMentor360 AWS account resources (ap-south-1).
# Rotate the access keys / CloudFront key pair before filling these in — the
# previous prototype committed them to git history.
AWS_REGION="ap-south-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET="globalmentor360-mumbai"
AWS_MEDIACONVERT_ENDPOINT="https://mediaconvert.ap-south-1.amazonaws.com"
AWS_MEDIACONVERT_ROLE_ARN="arn:aws:iam::304708116601:role/GlobalMentor360-MediaConvert-Role"
AWS_CLOUDFRONT_DOMAIN="d27v0f4tiwjim8.cloudfront.net"
# Regenerated key pair after the leak — leave empty until rotated.
AWS_CLOUDFRONT_KEY_PAIR_ID=""
# PEM private key. Prefer a single-line value with \n escapes, or a multiline
# quoted string. Never commit the real key.
AWS_CLOUDFRONT_PRIVATE_KEY=""
# Shared secret the EventBridge API destination sends as x-webhook-secret.
AWS_VIDEO_WEBHOOK_SECRET=""

# --- Payments (Stripe) ------------------------------------------------------
# One-time payments only — no subscriptions. Leave empty to hide the card rail.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Local webhook forwarding: stripe listen --forward-to localhost:3000/api/webhooks/stripe
