# Copy to .env and fill in. Never commit .env.

# --- Database ---------------------------------------------------------------
# Any Postgres 16+ instance. Local docker, Neon, Supabase, RDS — Prisma doesn't care.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/globalmentor360?schema=public"

# --- Auth (Better Auth) -----------------------------------------------------
# Generate with: npx @better-auth/cli secret
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# --- Video (Bunny Stream) ---------------------------------------------------
# Not needed until the upload/transcode pipeline is built.
BUNNY_STREAM_LIBRARY_ID=""
BUNNY_STREAM_API_KEY=""
BUNNY_STREAM_CDN_HOSTNAME=""
# Used to sign expiring playback URLs. Enable token auth on the library first.
BUNNY_STREAM_TOKEN_AUTH_KEY=""

# --- Payments (Stripe) ------------------------------------------------------
# Not needed until checkout is built. One-time payments only — no subscriptions.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
